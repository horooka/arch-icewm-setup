_get_projects() {
  local cache="$HOME/.cache/nav/dests.txt"
  local cache_age=60
  local mtime
  mkdir -p "${cache:h}" 2>/dev/null
  if [[ ! -f $cache ]]; then
    nav dests-list 2>/dev/null > "$cache"
  else
    mtime=$(stat -c %Y -- "$cache" 2>/dev/null) || mtime=0
    if (( EPOCHSECONDS - mtime > cache_age )); then
      nav dests-list 2>/dev/null > "$cache"
    fi
  fi

  cat "$cache" 2>/dev/null
}

# Escape a literal string so EXTENDED_GLOB treats it as match-all text.
_nav_glob_escape() {
  setopt localoptions extendedglob
  local s=$1
  s=${s//(#m)[\\*?\[\]()<>|#~^=]/\\$MATCH}
  print -r -- "$s"
}

_nav() {
  local -a display values specs
  local sgr disp value esc

  # dests-list emits "<sgr>\t<display>\t<value>". The display is shown and the
  # value is what gets inserted; coloring is handed to zsh's list-colors so it
  # stays aligned (raw ANSI in display strings counts as visible width).
  while IFS=$'\t' read -r sgr disp value; do
    [[ -z $value ]] && continue
    display+=( "$disp" )
    values+=( "$value" )
    if [[ -n $sgr && $sgr != - ]]; then
      esc=$(_nav_glob_escape "$disp")
      specs+=( "=${esc}=${sgr}" )
    fi
  done < <(_get_projects)

  if (( $#specs )); then
    zstyle ':completion:*:*:nav:*' list-colors "${specs[@]}"
  fi

  if (( CURRENT == 2 )); then
    _describe 'project' display values
  elif (( CURRENT == 3 )); then
    case $words[2] in
      go|brief|note|brief-go|note-go)
        _describe 'project' display values
        ;;
      *)
        _files
        ;;
    esac
  else
    _files
  fi
}
