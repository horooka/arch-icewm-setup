_get_projects() {
  local cache="$HOME/.cache/nav/projects.txt"
  local cache_age=60
  local mtime
  mkdir -p "${cache:h}" 2>/dev/null
  if [[ ! -f $cache ]]; then
    nav dests-list 2>/dev/null > "$cache"
  else
    mtime=$(stat -c %Y -- "$cache" 2>/dev/null) || mtime=0
    if (( EPOCHSECONDS - mtime > cache_age )); then
      nav dests-list 2>/dev/null > "$cache"
    fi
  fi

  cat "$cache" 2>/dev/null
}

_nav() {
  local -a display values
  local line icon value

  while IFS= read -r line; do
    [[ -z $line ]] && continue

    icon=${line[1,3]}
    value=${line[5,-1]}

    display+=( "$icon $value" )
    values+=( "$value" )
  done < <(_get_projects)

  if (( CURRENT == 2 )); then
    _describe 'project' display values
  elif (( CURRENT == 3 )); then
    case $words[2] in
      go|brief-go|note-go)
        _describe 'project' display values
        ;;
      *)
        _files
        ;;
    esac
  else
    _files
  fi
}
